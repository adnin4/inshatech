# Cloudflare Pages Edge Performance Headers & Enterprise Security Matrix

# 1. Immutable Static Assets (Images, Fonts, Scripts, Styles)
/adnin_sadat.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/portfolio_*.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/workflow_*.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/real_*.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/style.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff
/universal_ai_copilot.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff
/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff
/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

# 2. Public HTML Pages (Enterprise Security & Privacy Gate)
/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss:; img-src 'self' https: data: blob:; font-src 'self' https: data:; media-src 'self' https: data:;

# 3. Dynamic API Routes & AI Engine Endpoints (No-Store Private Edge Strategy)
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  X-Content-Type-Options: nosniff
  X-Accel-Buffering: no
