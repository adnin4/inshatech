# Cloudflare Pages Edge Performance Headers & Security Rules

# 1. Immutable Static Assets (Images, Fonts, Scripts, Styles)
/adnin_sadat.jpg
  Cache-Control: public, max-age=31536000, immutable
/portfolio_*.jpg
  Cache-Control: public, max-age=31536000, immutable
/workflow_*.jpg
  Cache-Control: public, max-age=31536000, immutable
/real_*.jpg
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/universal_ai_copilot.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 2. Public HTML Pages (Stale-While-Revalidate Edge Strategy)
/*.html
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# 3. Dynamic API Routes & AI Sessions (No-Store Private Cache)
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  X-Accel-Buffering: no
  Access-Control-Allow-Origin: *
